rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserOrgId() {
      return request.auth.token.organizationId;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isSameOrg(orgId) {
      return isSignedIn() && getUserOrgId() == orgId;
    }

    // organizations コレクション
    // 自組織のみ読み取り可。書き込みは Node.js Admin SDK 経由のみ。
    match /organizations/{orgId} {
      allow read: if isSameOrg(orgId);
      allow write: if false;
    }

    // employees コレクション
    // 自組織のみ読み取り可。書き込みは Node.js Admin SDK 経由のみ。
    match /employees/{employeeId} {
      allow read: if isSignedIn() && isSameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // settings コレクション
    // 自組織の admin のみ読み書き可。
    match /settings/{settingId} {
      allow read: if isSignedIn() && isSameOrg(resource.data.organizationId);
      allow write: if false;
    }

    // requests コレクション
    // 同組織の admin は全件読み取り可。メンバーは自分の申請のみ読み取り可。
    // 書き込みは Node.js Admin SDK 経由のみ。
    match /requests/{requestId} {
      allow read: if isSignedIn()
        && isSameOrg(resource.data.organizationId)
        && (getUserRole() == 'admin' || request.auth.uid == resource.data.requestedBy);
      allow write: if false;
    }

    // chatHistory コレクション
    // 本人のみ読み書き可。書込時はフィールド型・サイズを検証。
    match /chatHistory/{userId}/{document=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.content is string
        && request.resource.data.content.size() < 4096
        && request.resource.data.role is string
        && request.resource.data.role in ['user', 'model'];
    }
  }
}
